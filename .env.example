# ── SERVEUR ──────────────────────────────
PORT=5000
NODE_ENV=development
# Nom affiché dans les apps et les SMS (nom provisoire)
APP_NOM=Kolis
# Préfixe des numéros de suivi : KL-26-00001
PREFIXE_SUIVI=KL
# En local : sert aussi les 3 apps (/, /agent, /admin) depuis ce serveur
SERVIR_APPS=1

# ── BASE DE DONNÉES ───────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kolis

# ── JWT ───────────────────────────────────
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=7d

# ── ADMINISTRATEURS ───────────────────────
# Numéros promus admin à la connexion (séparés par des virgules)
ADMIN_TELEPHONES=+33600000000

# ── SMS (Twilio) ──────────────────────────
# Sans ces clés, les SMS sont affichés dans la console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── PAIEMENT CARTE (Stripe, facultatif) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ADRESSES DES APPS (CORS + liens dans les SMS) ──
FRONTEND_URL=https://kolis-client.netlify.app
AGENT_URL=https://kolis-agent.netlify.app
ADMIN_URL=https://kolis-admin.netlify.app
