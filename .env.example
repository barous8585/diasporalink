# ── SERVEUR ──────────────────────────────
PORT=5000
NODE_ENV=development
# Nom affiché dans les apps et les SMS (apps, étiquettes, documents)
APP_NOM=Talib Multi Services
APP_NOM_COURT=TMS
# Préfixe des numéros de suivi : TMS-26-00001
PREFIXE_SUIVI=TMS
# En local : sert aussi les 3 apps (/, /agent, /admin) depuis ce serveur
SERVIR_APPS=1

# ── BASE DE DONNÉES ───────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kolis

# ── JWT ───────────────────────────────────
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire

# ── ADMINISTRATEURS ───────────────────────
# Numéros administrateurs (séparés par des virgules)
ADMIN_TELEPHONES=+33600000000
# Mot de passe du tout premier accès admin (à changer ensuite dans l'app).
# Il ne sert que tant que le compte n'a pas encore de mot de passe.
ADMIN_MOT_DE_PASSE=

# ── CONNEXION ─────────────────────────────
# motdepasse (par défaut) ; sms seulement quand un fournisseur SMS est branché
AUTH_MODE=motdepasse

# ── SMS ───────────────────────────────────
# Aucun fournisseur pour l'instant : les SMS ne partent pas.
# Renseigner quand un fournisseur sera branché dans utils/sms.js.
SMS_FOURNISSEUR=

# ── PAIEMENT CARTE (Stripe, facultatif) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ADRESSES DES APPS (CORS + liens dans les SMS) ──
FRONTEND_URL=https://kolis-client.netlify.app
AGENT_URL=https://kolis-agent.netlify.app
ADMIN_URL=https://kolis-admin.netlify.app
